{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@pi-rs/desktop-sdk": ["../../../../packages/pi-desktop-sdk/index.d.ts"],
      "react": ["../../../../apps/pi-desktop/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../../../apps/pi-desktop/node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["src"]
}
